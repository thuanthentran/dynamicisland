<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparse package ("packaged with external location"): gives the unpackaged exe package identity so it can use
  UserNotificationListener. Identity Name/Publisher and Application Id must match the <msix> element in app.manifest.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap10 rescap">

  <Identity Name="DynamicIsland.Dev" Publisher="CN=DynamicIslandDev" Version="0.1.0.0" ProcessorArchitecture="neutral" />

  <Properties>
    <DisplayName>Dynamic Island (Dev)</DisplayName>
    <PublisherDisplayName>DynamicIsland Dev</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <uap3:Capability Name="userNotificationListener" />
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
    <!-- Wi-Fi and Bluetooth tiles: Windows.Devices.Radios needs it to change radio state when the app has identity. -->
    <DeviceCapability Name="radios" />
  </Capabilities>

  <Applications>
    <Application Id="DynamicIsland" Executable="DynamicIsland.exe"
                 uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements AppListEntry="none"
                          DisplayName="Dynamic Island"
                          Description="Dynamic Island"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
</Package>
