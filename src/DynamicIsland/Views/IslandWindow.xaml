<Window x:Class="DynamicIsland.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DynamicIsland.ViewModels"
        xmlns:views="clr-namespace:DynamicIsland.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:IslandViewModel}"
        Title="Dynamic Island"
        Width="900" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Opacity="0" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        Foreground="{DynamicResource Island.Foreground}">

    <Window.Resources>
        <views:BoolToVisibilityConverter x:Key="Visible" />
        <views:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
        <views:EqualsConverter x:Key="Equals" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        <!-- Spacing inside the status cluster; the small island overrides it. -->
        <Thickness x:Key="Island.StatusGap">12,0,0,0</Thickness>
        <Thickness x:Key="Island.ClockGap">10,0,0,0</Thickness>
        <sys:Double x:Key="Island.StatusIconSize">15</sys:Double>

        <!-- Palette placeholders (Windows 11 dark tokens); the host replaces them from IslandViewModel.Palette. -->
        <SolidColorBrush x:Key="Island.Foreground" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="Island.Secondary" Color="#C5FFFFFF" />
        <SolidColorBrush x:Key="Island.Tertiary" Color="#87FFFFFF" />
        <SolidColorBrush x:Key="Island.Card" Color="#0DFFFFFF" />
        <SolidColorBrush x:Key="Island.CardStroke" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="Island.Hover" Color="#0FFFFFFF" />
        <SolidColorBrush x:Key="Island.Pressed" Color="#0AFFFFFF" />
        <SolidColorBrush x:Key="Island.ControlFill" Color="#15FFFFFF" />
        <SolidColorBrush x:Key="Island.ControlStrong" Color="#8BFFFFFF" />
        <SolidColorBrush x:Key="Island.Track" Color="#60FFFFFF" />
        <SolidColorBrush x:Key="Island.Thumb" Color="#FF454545" />
        <SolidColorBrush x:Key="Island.Accent" Color="#60CDFF" />
        <SolidColorBrush x:Key="Island.OnAccent" Color="#FF000000" />

        <!-- Windows 11 type ramp -->
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Island.Secondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CaptionTertiary" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Foreground" Value="{DynamicResource Island.Tertiary}" />
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatusIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="{DynamicResource Island.StatusIconSize}" />
        </Style>

        <!-- Subtle button: transparent until hovered, 4px corners (ControlCornerRadius). -->
        <Style x:Key="SubtleButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="4" Background="Transparent">
                            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Island.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Island.Pressed}" />
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.36" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallSubtleButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
        </Style>

        <!-- "^" at the end of the small island: hides it until the pointer is pushed against the top edge. -->
        <Style x:Key="StowButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Content" Value="&#xE70E;" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="{DynamicResource Island.Secondary}" />
            <Setter Property="Margin" Value="10,0,-14,0" />
        </Style>

        <!-- Standard button (ControlFill + stroke). -->
        <Style x:Key="StandardButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="4" Padding="{TemplateBinding Padding}" BorderThickness="1"
                                Background="{DynamicResource Island.ControlFill}" BorderBrush="{DynamicResource Island.CardStroke}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Island.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Island.Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hyperlink button: accent text. -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Island.Accent}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Island.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Island.Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Quick-close handle: a grabber bar flush with the screen's top edge, where the cursor rested to open the island,
          so closing is a click without moving the mouse. Square top corners: it touches the edge.
        -->
        <Style x:Key="HandleButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Width="96" Height="18" CornerRadius="0,0,4,4" Background="Transparent">
                            <Border x:Name="Bar" Width="32" Height="4" CornerRadius="2" Margin="0,6,0,0" VerticalAlignment="Top"
                                    Background="{DynamicResource Island.Tertiary}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Island.Hover}" />
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Island.Secondary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Island.Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented choice: radio buttons in a 4px track; the selected one fills with accent. -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" CornerRadius="3" Padding="12,4" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Island.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Island.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Island.OnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegmentTrack" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Island.ControlFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Island.CardStroke}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Windows 11 ToggleSwitch: outlined when off, accent with a dark knob when on. -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                                Background="Transparent" BorderBrush="{DynamicResource Island.ControlStrong}">
                            <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0"
                                     Fill="{DynamicResource Island.ControlStrong}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="Shift" X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Width" Value="14" />
                                <Setter TargetName="Knob" Property="Height" Value="14" />
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Island.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Island.Accent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Island.Accent}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Island.OnAccent}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="X" To="19" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.36" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 ToggleButton used as a chip. -->
        <Style x:Key="Chip" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Chrome" CornerRadius="4" Padding="12,5" BorderThickness="1"
                                Background="{DynamicResource Island.ControlFill}" BorderBrush="{DynamicResource Island.CardStroke}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Island.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Island.Accent}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Island.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Island.OnAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.36" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Island.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Island.CardStroke}" />
        </Style>
        <Style x:Key="SettingCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Caps/Num Lock indicator: a small outlined keycap. -->
        <Style x:Key="LockBadge" TargetType="Border">
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Island.Secondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LockBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Network, volume, battery, lock keys and clock as the taskbar shows them; shared by every size. -->
        <DataTemplate x:Key="StatusCluster" DataType="{x:Type vm:IslandViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Opacity="{Binding NetworkOpacity}">
                    <TextBlock Style="{StaticResource StatusIcon}" Text="{Binding NetworkBaseGlyph}" Opacity="0.3" />
                    <TextBlock Style="{StaticResource StatusIcon}" Text="{Binding NetworkGlyph}" />
                </Grid>
                <TextBlock Style="{StaticResource StatusIcon}" Text="{Binding VolumeGlyph}" Margin="{DynamicResource Island.StatusGap}" />
                <StackPanel Orientation="Horizontal" Margin="{DynamicResource Island.StatusGap}" Visibility="{Binding HasBattery, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource StatusIcon}" Text="{Binding BatteryGlyph}" />
                    <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource Island.Foreground}"
                               Text="{Binding BatteryText}" Margin="5,0,0,0" MinWidth="28" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="{DynamicResource Island.StatusGap}"
                            Visibility="{Binding HasLockBadge, Converter={StaticResource Visible}}">
                    <Border Style="{StaticResource LockBadge}" Visibility="{Binding CapsBadge, Converter={StaticResource Visible}}">
                        <TextBlock Style="{StaticResource LockBadgeText}" Text="C" />
                    </Border>
                    <Border Visibility="{Binding NumBadge, Converter={StaticResource Visible}}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource LockBadge}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CapsBadge}" Value="True">
                                        <Setter Property="Margin" Value="4,0,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource LockBadgeText}" Text="N" />
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource Island.Foreground}" FontWeight="SemiBold"
                           Text="{Binding ClockText}" Margin="{DynamicResource Island.ClockGap}" MinWidth="34" TextAlignment="Right" />
            </StackPanel>
        </DataTemplate>

        <!-- Small island status: on a Caps/Num Lock toggle the cluster steps aside to the left for a short toast. -->
        <DataTemplate x:Key="SmallStatus" DataType="{x:Type vm:IslandViewModel}">
            <Grid>
                <ContentControl x:Name="Cluster" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource StatusCluster}">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="ClusterShift" />
                    </ContentControl.RenderTransform>
                </ContentControl>
                <StackPanel x:Name="Toast" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="ToastShift" X="24" />
                    </StackPanel.RenderTransform>
                    <TextBlock Style="{StaticResource StatusIcon}" Text="&#xE765;" />
                    <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource Island.Foreground}" FontWeight="SemiBold"
                               Text="{Binding LockToastText}" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLockToastVisible}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ClusterShift" Storyboard.TargetProperty="X" To="-24" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseIn" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Cluster" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetName="ToastShift" Storyboard.TargetProperty="X" From="24" To="0"
                                                 BeginTime="0:0:0.06" Duration="0:0:0.3">
                                    <DoubleAnimation.EasingFunction>
                                        <QuinticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Toast" Storyboard.TargetProperty="Opacity" To="1"
                                                 BeginTime="0:0:0.06" Duration="0:0:0.3" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ToastShift" Storyboard.TargetProperty="X" To="24" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseIn" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Toast" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetName="ClusterShift" Storyboard.TargetProperty="X" From="-24" To="0"
                                                 BeginTime="0:0:0.06" Duration="0:0:0.3">
                                    <DoubleAnimation.EasingFunction>
                                        <QuinticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Cluster" Storyboard.TargetProperty="Opacity" To="1"
                                                 BeginTime="0:0:0.06" Duration="0:0:0.3" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- App line of a media card, like Quick Settings: logo and name. -->
        <DataTemplate x:Key="SourceApp" DataType="{x:Type vm:IslandViewModel}">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding SourceAppIcon}" Width="16" Height="16" Margin="0,0,8,0"
                       Visibility="{Binding HasSourceAppIcon, Converter={StaticResource Visible}}" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding SourceAppName}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MediaControls" DataType="{x:Type vm:IslandViewModel}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource SubtleButton}" Content="&#xF8AC;" Command="{Binding PreviousCommand}" />
                <Button Style="{StaticResource SubtleButton}" Content="{Binding PlayPauseGlyph}" Command="{Binding PlayPauseCommand}" Margin="12,0" />
                <Button Style="{StaticResource SubtleButton}" Content="&#xF8AD;" Command="{Binding NextCommand}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <views:IslandSurface x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top"
                         ShapeWidth="200" ShapeHeight="36">
        <views:IslandSurface.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{Binding NotificationStatusText}" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
            </ContextMenu>
        </views:IslandSurface.ContextMenu>

        <Grid x:Name="ContentHost" Width="840">

            <!-- Small, idle: system status only -->
            <Grid x:Name="SmallIdlePanel" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
                <Grid.Resources>
                    <!-- Docked, the island has square top corners; wider spacing keeps its proportions calm. -->
                    <Thickness x:Key="Island.StatusGap">16,0,0,0</Thickness>
                    <Thickness x:Key="Island.ClockGap">16,0,0,0</Thickness>
                    <sys:Double x:Key="Island.StatusIconSize">14</sys:Double>
                </Grid.Resources>
                <StackPanel Orientation="Horizontal" Margin="22,0" VerticalAlignment="Center">
                    <ContentControl Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource SmallStatus}" />
                    <Button x:Name="StowIdleButton" Style="{StaticResource StowButton}" />
                </StackPanel>
            </Grid>

            <!-- Stowed: nothing to show. Pushing the pointer against the top edge where the island was opens it. -->
            <Grid x:Name="StowedPanel" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" />

            <!--
              Small, playing: media on the left (artwork, equalizer, the line being sung when lyrics were found), system
              status on the right. The lyric slot has a fixed width (fits ~95% of real lyric lines at 12px), so a new line
              never resizes the island.
            -->
            <Grid x:Name="SmallMediaPanel" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
                <Grid.Resources>
                    <Thickness x:Key="Island.StatusGap">16,0,0,0</Thickness>
                    <Thickness x:Key="Island.ClockGap">16,0,0,0</Thickness>
                    <sys:Double x:Key="Island.StatusIconSize">14</sys:Double>
                </Grid.Resources>
                <StackPanel Orientation="Horizontal" Margin="5,0,22,0" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource Island.ControlFill}">
                        <Border CornerRadius="4">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Border>
                    <views:EqualizerBars x:Name="Equalizer" Height="12" Margin="12,0,0,0" VerticalAlignment="Center"
                                         BarBrush="{Binding EqualizerBrush}" />
                    <TextBlock x:Name="SmallLyric" Style="{StaticResource Caption}" Foreground="{DynamicResource Island.Foreground}"
                               Width="270" Margin="12,0,0,0" Text="{Binding CurrentLyric}"
                               Visibility="{Binding HasLyrics, Converter={StaticResource Visible}}">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="SmallLyricShift" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <Rectangle Width="1" Height="14" Margin="16,0" Fill="{DynamicResource Island.CardStroke}" />
                    <ContentControl Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource SmallStatus}" />
                    <Button x:Name="StowMediaButton" Style="{StaticResource StowButton}" />
                </StackPanel>
            </Grid>

            <!-- Banner: a new notification, swapped in over small or medium content -->
            <Grid x:Name="BannerPanel" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
                <Grid Margin="16,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="24" Height="24" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA8F;" HorizontalAlignment="Center"
                                   Visibility="{Binding HasBannerIcon, Converter={StaticResource Hidden}}" />
                        <Image Source="{Binding BannerIcon}" Stretch="Uniform"
                               Visibility="{Binding HasBannerIcon, Converter={StaticResource Visible}}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrong}">
                            <Run Text="{Binding BannerTitle, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,1,0,0">
                            <Run Text="{Binding BannerApp, Mode=OneWay}" />
                            <Run Text="·" Foreground="{DynamicResource Island.Tertiary}" />
                            <Run Text="{Binding BannerBody, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>

            <!--
              Medium: a glance card with nothing to click. Hovering it expands to the large island, so controls here would
              jump away from the pointer.
            -->
            <StackPanel x:Name="MediumPanel" Width="480" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
                <Grid Margin="12,12,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="4" Background="{DynamicResource Island.ControlFill}">
                        <Border CornerRadius="4">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                        <TextBlock Style="{StaticResource BodyStrong}" Text="{Binding Title}" />
                        <!-- The line being sung; the artist when the track has no lyrics. -->
                        <TextBlock x:Name="MediumLyric" Style="{StaticResource Caption}" Text="{Binding CurrentLyric}" Margin="0,2,0,0"
                                   Visibility="{Binding HasLyrics, Converter={StaticResource Visible}}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Artist}" Margin="0,2,0,0"
                                   Visibility="{Binding HasLyrics, Converter={StaticResource Hidden}}" />
                    </StackPanel>
                    <views:EqualizerBars x:Name="MediumEqualizer" Grid.Column="2" Height="14" VerticalAlignment="Center"
                                         BarBrush="{Binding EqualizerBrush}" />
                </Grid>
            </StackPanel>

            <!-- Large: media and lyrics on the left, notifications on the right -->
            <StackPanel x:Name="LargePanel" Width="840" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
                <StackPanel Margin="20,0,20,20">
                    <Grid Height="44">
                        <Button Style="{StaticResource SmallSubtleButton}" Content="&#xE713;" Command="{Binding OpenSettingsCommand}"
                                HorizontalAlignment="Left" />
                        <Button x:Name="QuickCloseButton" Style="{StaticResource HandleButton}" HorizontalAlignment="Center"
                                VerticalAlignment="Top" />
                        <ContentControl HorizontalAlignment="Right" Margin="0,0,4,0" Focusable="False"
                                        Content="{Binding}" ContentTemplate="{StaticResource StatusCluster}" />
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="480" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Border Style="{StaticResource Card}" Padding="16,14,16,10" Visibility="{Binding HasMedia, Converter={StaticResource Visible}}">
                                <StackPanel>
                                    <ContentControl Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource SourceApp}" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Style="{StaticResource Subtitle}" Text="{Binding Title}" />
                                            <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource Island.Secondary}"
                                                       Text="{Binding Artist}" Margin="0,2,0,0" />
                                            <TextBlock Style="{StaticResource CaptionTertiary}" Text="{Binding Album}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="88" Height="88" CornerRadius="6" Background="{DynamicResource Island.ControlFill}">
                                            <Border CornerRadius="6">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource CaptionTertiary}" Text="{Binding PositionText}" />
                                        <views:SeekBar Grid.Column="1" Value="{Binding Progress}" Command="{Binding SeekCommand}" IsEnabled="{Binding CanSeek}"
                                                       TrackBrush="{DynamicResource Island.Track}" FillBrush="{DynamicResource Island.Accent}"
                                                       ThumbBrush="{DynamicResource Island.Thumb}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionTertiary}" Text="{Binding DurationText}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <ContentControl Focusable="False" Margin="0,4,0,0" Content="{Binding}" ContentTemplate="{StaticResource MediaControls}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="16" Visibility="{Binding HasMedia, Converter={StaticResource Hidden}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEC4F;" Foreground="{DynamicResource Island.Tertiary}" />
                                    <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource Island.Secondary}"
                                               Text="{Binding Title}" Margin="12,0,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Lyrics: previous, current, next -->
                            <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="16,12" ClipToBounds="True"
                                    Visibility="{Binding HasLyrics, Converter={StaticResource Visible}}">
                                <StackPanel x:Name="LyricsStack">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="LyricsShift" />
                                    </StackPanel.RenderTransform>
                                    <TextBlock Style="{StaticResource CaptionTertiary}" Text="{Binding PreviousLyric}" HorizontalAlignment="Center" />
                                    <TextBlock Style="{StaticResource BodyStrong}" Text="{Binding CurrentLyric}" HorizontalAlignment="Center"
                                               FontSize="16" Margin="0,6" />
                                    <TextBlock Style="{StaticResource CaptionTertiary}" Text="{Binding NextLyric}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Notifications -->
                        <StackPanel Grid.Column="2">
                            <Grid Height="28" Margin="2,0,0,4">
                                <TextBlock Style="{StaticResource BodyStrong}" Text="Notifications" />
                                <Button Style="{StaticResource LinkButton}" Content="Clear all" HorizontalAlignment="Right"
                                        Command="{Binding ClearNotificationsCommand}"
                                        Visibility="{Binding HasNotifications, Converter={StaticResource Visible}}" />
                            </Grid>
                            <Border Style="{StaticResource Card}" Padding="16,14"
                                    Visibility="{Binding HasNotifications, Converter={StaticResource Hidden}}">
                                <TextBlock Style="{StaticResource CaptionTertiary}" Text="No new notifications" HorizontalAlignment="Center" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding VisibleNotifications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:NotificationItemViewModel}">
                                        <Border x:Name="Card" Style="{StaticResource Card}" Padding="12,10,8,10" Margin="0,0,0,4" Opacity="0">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="CardShift" X="24" />
                                            </Border.RenderTransform>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,0,0">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEA8F;" FontSize="14" HorizontalAlignment="Center"
                                                               Visibility="{Binding HasIcon, Converter={StaticResource Hidden}}" />
                                                    <Image Source="{Binding Icon}" Stretch="Uniform"
                                                           Visibility="{Binding HasIcon, Converter={StaticResource Visible}}" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="10,0,4,0">
                                                    <Grid>
                                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding AppName}" Margin="0,0,40,0" />
                                                        <TextBlock Style="{StaticResource CaptionTertiary}" Text="{Binding TimeText}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <TextBlock Style="{StaticResource BodyStrong}" Text="{Binding Title}" Margin="0,4,0,0" />
                                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Body}" Margin="0,1,0,0"
                                                               Visibility="{Binding HasBody, Converter={StaticResource Visible}}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource SmallSubtleButton}" Content="&#xE711;" FontSize="10"
                                                        Width="24" Height="24" VerticalAlignment="Top" Command="{Binding RemoveCommand}" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="Card">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" />
                                                        <DoubleAnimation Storyboard.TargetName="CardShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.32">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuinticEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource CaptionTertiary}" Text="{Binding MoreNotificationsText}" Margin="2,4,0,0"
                                       Visibility="{Binding HasMoreNotifications, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- Settings, entered from the large island; cards like the Windows Settings app -->
            <StackPanel x:Name="SettingsPanel" Width="840" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
                <StackPanel Margin="20,6,20,20" DataContext="{Binding Settings}">
                    <Grid Height="36" Margin="0,0,0,8">
                        <Button Style="{StaticResource SmallSubtleButton}" Content="&#xE72B;" HorizontalAlignment="Left"
                                Command="{Binding DataContext.CloseSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <TextBlock Style="{StaticResource BodyStrong}" Text="Settings" Margin="44,0,0,0" />
                    </Grid>

                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Body}" Text="Theme" />
                                <TextBlock Style="{StaticResource Caption}" Text="Match Windows, light or dark" />
                            </StackPanel>
                            <Border Style="{StaticResource SegmentTrack}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Content="System"
                                                 IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=System}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Content="Light"
                                                 IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Light}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Content="Dark"
                                                 IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Dark}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Body}" Text="Hover to expand" />
                                <TextBlock Style="{StaticResource Caption}" Text="How long the pointer rests on the island before it expands" />
                            </StackPanel>
                            <Border Style="{StaticResource SegmentTrack}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="OpenDelay" Content="Fast"
                                                 IsChecked="{Binding OpenDelayMs, Converter={StaticResource Equals}, ConverterParameter=150}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="OpenDelay" Content="Normal"
                                                 IsChecked="{Binding OpenDelayMs, Converter={StaticResource Equals}, ConverterParameter=300}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="OpenDelay" Content="Slow"
                                                 IsChecked="{Binding OpenDelayMs, Converter={StaticResource Equals}, ConverterParameter=500}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Body}" Text="Collapse media card after" />
                                <TextBlock Style="{StaticResource Caption}" Text="Shown when you leave the expanded island while music plays" />
                            </StackPanel>
                            <Border Style="{StaticResource SegmentTrack}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Medium" Content="2 s"
                                                 IsChecked="{Binding MediumTimeoutSeconds, Converter={StaticResource Equals}, ConverterParameter=2}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Medium" Content="3 s"
                                                 IsChecked="{Binding MediumTimeoutSeconds, Converter={StaticResource Equals}, ConverterParameter=3}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Medium" Content="5 s"
                                                 IsChecked="{Binding MediumTimeoutSeconds, Converter={StaticResource Equals}, ConverterParameter=5}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Body}" Text="Show notifications for" />
                                <TextBlock Style="{StaticResource Caption}" Text="How long a new notification stays on the island" />
                            </StackPanel>
                            <Border Style="{StaticResource SegmentTrack}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Banner" Content="3 s"
                                                 IsChecked="{Binding NotificationSeconds, Converter={StaticResource Equals}, ConverterParameter=3}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Banner" Content="5 s"
                                                 IsChecked="{Binding NotificationSeconds, Converter={StaticResource Equals}, ConverterParameter=5}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Banner" Content="8 s"
                                                 IsChecked="{Binding NotificationSeconds, Converter={StaticResource Equals}, ConverterParameter=8}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Body}" Text="Lyrics" />
                                <TextBlock Style="{StaticResource Caption}" Text="Look up synced lyrics online by title and artist" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LyricsEnabled}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Body}" Text="Lyrics sources" />
                                <TextBlock Style="{StaticResource Caption}" Text="QQ Music is tried first; the others run in parallel" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        IsEnabled="{Binding LyricsEnabled}">
                                <CheckBox Style="{StaticResource Chip}" Content="QQ Music" IsChecked="{Binding QqMusicEnabled}" />
                                <CheckBox Style="{StaticResource Chip}" Content="NetEase" IsChecked="{Binding NetEaseEnabled}" />
                                <CheckBox Style="{StaticResource Chip}" Content="LRCLIB" IsChecked="{Binding LrclibEnabled}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Body}" Text="Start with Windows" />
                                <TextBlock Style="{StaticResource Caption}" Text="Launch when you sign in" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" />
                        </Grid>
                    </Border>

                    <Grid Margin="2,8,0,0">
                        <TextBlock Style="{StaticResource CaptionTertiary}"
                                   Text="{Binding DataContext.NotificationStatusText, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Style="{StaticResource StandardButton}" Content="Exit Dynamic Island" HorizontalAlignment="Right" FontSize="12"
                                Command="{Binding DataContext.ExitCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Grid>
    </views:IslandSurface>
</Window>
